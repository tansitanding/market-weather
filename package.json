{
  "name": "market-weather",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite web --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build web",
    "test:data": "PYTHONPATH=src python3 -m unittest discover -s tests -v",
    "preview": "vite preview web --host 127.0.0.1",
    "test:web": "node --test tests/web/*.test.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
